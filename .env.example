# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://skybox:skybox@localhost:5432/skybox

# Redis / queue
REDIS_URL=redis://localhost:6379

# Object storage (Silo/MinIO-compatible local / R2 prod)
# Local compose uses pgsty/silo (minio/minio Docker images are no longer pullable)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=skybox
S3_SECRET_ACCESS_KEY=skyboxsecret
S3_BUCKET=skybox-demos
S3_FORCE_PATH_STYLE=true
# R2: set S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com and S3_FORCE_PATH_STYLE=false

# Auth (Steam OpenID — no API key required for login)
AUTH_SECRET=change-me-to-a-long-random-string
# Required in production: only this SteamID64 may bootstrap the first admin.
# In development, if unset, the first Steam login becomes admin.
SEED_ADMIN_STEAM_ID=76561198000000000
SEED_TEAM_NAME=Team Local

# Limits
MAX_DEMO_SIZE_MB=512
DEMO_RETENTION_DAYS=90
