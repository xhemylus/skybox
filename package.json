{
  "name": "skybox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @skybox/web",
    "dev:worker": "npm run dev -w @skybox/worker",
    "build": "npm run build -w @skybox/shared && npm run build -w @skybox/web && npm run build -w @skybox/worker",
    "db:generate": "npm run db:generate -w @skybox/web",
    "db:migrate": "npm run db:migrate -w @skybox/web",
    "db:seed": "npm run db:seed -w @skybox/web",
    "lint": "npm run lint -w @skybox/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "setup": "npm install && npm run build -w @skybox/shared && npm run db:migrate && npm run db:seed",
    "purge:retention": "npm run purge:retention -w @skybox/web"
  },
  "engines": {
    "node": ">=22.15"
  }
}
