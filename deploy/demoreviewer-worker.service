[Unit]
Description=DemoReviewer worker (BullMQ parse)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/demoreviewer
Environment=NODE_ENV=production
EnvironmentFile=/opt/demoreviewer/.env
ExecStart=/usr/bin/npm run start -w @skybox/worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
