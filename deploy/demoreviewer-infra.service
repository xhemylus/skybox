[Unit]
Description=DemoReviewer infra (Postgres + Redis via Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/demoreviewer
ExecStart=/usr/bin/docker compose up -d postgres redis
ExecStop=/usr/bin/docker compose stop postgres redis
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
