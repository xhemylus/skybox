[Unit]
Description=DemoReviewer web (Next.js)
Requires=demoreviewer-infra.service
After=network.target docker.service demoreviewer-infra.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/demoreviewer
Environment=NODE_ENV=production
EnvironmentFile=/opt/demoreviewer/.env
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/npm run start -w @skybox/web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
